@media(max-width:800px){.nl-port-scene{min-height:140px!important;display:block!important}.nl-port-crane{height:117px!important}.nl-port-ship{height:38px!important}.nl-port-stack{height:45px!important;bottom:31px!important}.nl-login-benefits{margin-top:15px}.auth-right{padding:28px 24px!important}.nl-login-switch-row{margin-bottom:16px}}
@media(max-width:480px){.nl-port-scene{display:none!important}.nl-login-benefits{grid-template-columns:repeat(3,minmax(0,1fr))}.nl-login-benefits span{font-size:.67rem;padding:8px 5px}.nl-login-toast{left:14px;bottom:14px}.auth-body{padding:11px!important}}
@media(prefers-reduced-motion:reduce){.nl-login-toast{animation:none!important}}

/* Embedded optimized port photography: self-contained JSP, no asset file or request. */
:root{--nl-login-photo:url("data:image/webp;base64,")}
body.auth-body{background-image:linear-gradient(135deg,#fff3e9c9,#ffe8d5bf),var(--nl-login-photo)!important;background-size:cover!important;background-position:center center!important}
.auth-left{background-image:linear-gradient(115deg,#231e2ae5,#352536c9 55%,#532f27a0),var(--nl-login-photo)!important;background-size:cover!important;background-position:58% center!important}
.nl-port-scene{opacity:.12;mix-blend-mode:screen}
html[data-nl-mode=dark] body.auth-body{background-image:linear-gradient(135deg,#101826e3,#111924e7),var(--nl-login-photo)!important}
html[data-nl-mode=dark] .auth-left{background-image:linear-gradient(115deg,#141b29e8,#171e2cc8 55%,#302838a7),var(--nl-login-photo)!important}
</style></head>
<body data-nl-screen="module1-login" class="auth-body"><main class="auth-frame"><div class="auth-left"><a class="brand" href="${requestScope.nlv_Module1_login__1}/Module1Controller?action=viewLogin"><span class="brand-mark"><img src="data:image/svg+xml;base64," width="21" height="21" alt="" aria-hidden="true"></span><span>N-LOGISTIC</span></a><div><div class="caps" style="color:#ffd399;margin-bottom:18px">N-LOGISTIC · CARGO OPERATIONS</div><h1>Global cargo.<br><span>One workspace.</span></h1><p>Bookings, tracking and invoices in one secure portal.</p><div class="nl-login-benefits" aria-label="Platform capabilities"><span>BOOKINGS</span><span>TRACKING</span><span>BILLING</span></div></div><div class="nl-port-scene" aria-hidden="true"><span class="nl-port-crane"></span><span class="nl-port-ship"></span><span class="nl-port-stack"></span></div></div>
<div class="auth-right"><div class="auth-login-intro">
<div class="nl-login-switch-row"><span class="pill">SECURE ACCOUNT ACCESS</span><button type="button" class="nl-theme-switch" data-nl-theme-toggle aria-pressed="false"><span data-nl-theme-symbol aria-hidden="true">&#9790;</span><span data-nl-theme-label>Dark mode</span></button></div>
<h2>Welcome back<span class="auth-login-period">.</span></h2><p class="nl-login-introline">Your logistics workspace, ready when you are. Sign in to manage bookings, shipments and invoices.</p></div>
${requestScope.nlv_Module1_login__2}
<form action="${requestScope.nlv_Module1_login__3}/Module1Controller" method="post" autocomplete="on"><input type="hidden" name="action" value="login"/><input type="hidden" name="csrfToken" value="${requestScope.nlv_Module1_login__4}"/>
<div class="field"><label for="email">Email address</label><input class="input" name="email" id="email" type="email" placeholder="Enter your email address" autocomplete="username" inputmode="email" spellcheck="false" required maxlength="120"/></div>
<div class="field"><label for="pw">Password</label><div class="password-wrap"><input class="input" name="password" id="pw" type="password" placeholder="Enter your password" autocomplete="current-password" required/><button class="btn light" type="button" id="togglePassword" aria-controls="pw" aria-pressed="false">Show</button></div><small id="nlCapsWarning" class="nl-auth-caps" role="status" hidden="hidden">Caps Lock is on. Passwords are case-sensitive.</small></div>
<button class="btn primary" type="submit">Sign in &rarr;</button>
<div class="nl-login-secure">Secure sign-in with role-based account access.</div>
<div style="margin-top:14px;padding:10px 12px;border:1px dashed #dca579;border-radius:10px;background:#fff8f1;">
  <div style="font-size:0.75rem;font-weight:750;color:#9b5133;margin-bottom:6px;">Quick Demo Fill:</div>
  <div style="display:flex;gap:6px;flex-wrap:wrap;">
    <button type="button" class="btn light small" onclick="fillDemo('admin@gmail.com','Admin@2026QA!')">&#128100; Admin</button>
    <button type="button" class="btn light small" onclick="fillDemo('seller@gmail.com','Seller@2026QA!')">&#128674; Seller</button>
    <button type="button" class="btn light small" onclick="fillDemo('user@gmail.com','User@2026QA!')">&#128722; Consumer</button>
  </div>
</div>
</form>
<a class="nl-auth-register nl-auth-register-link" href="${requestScope.nlv_Module1_login__5}/Module1Controller?action=viewRegister" aria-label="Create a new N-LOGISTIC account"><span>New to N-LOGISTIC?</span><strong>Create an account <span aria-hidden="true">&rarr;</span></strong></a>
<div class="auth-back"><span aria-hidden="true">●</span> Secure, role-based access for Admin, Seller and Consumer accounts.</div></div></main>
<script>
function fillDemo(e,p){document.getElementById('email').value=e;document.getElementById('pw').value=p;}
document.getElementById('togglePassword').addEventListener('click',function(){var el=document.getElementById('pw');var show=el.type==='password';el.type=show?'text':'password';this.textContent=show?'Hide':'Show';this.setAttribute('aria-pressed',String(show));});
</script><script>
(function(){'use strict';
const field=document.getElementById('pw'),note=document.getElementById('nlCapsWarning');
if(field&&note){field.addEventListener('keydown',function(event){note.hidden=!event.getModifierState('CapsLock');});field.addEventListener('blur',()=>{note.hidden=true;});}
const form=field&&field.closest('form');if(form)form.addEventListener('submit',function(event){if(event.defaultPrevented||!form.checkValidity())return;const submit=form.querySelector('button[type=submit]');if(submit)submit.setAttribute('aria-busy','true');});
})();
</script></body></html>