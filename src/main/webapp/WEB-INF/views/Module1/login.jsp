html[data-nl-mode=dark] .nl-login-status{background:#3e2c2a;color:#ffd1ba;border-color:#7e5445}
html[data-nl-mode=dark] .nl-login-status[data-kind=success]{background:#19382e;color:#a6efc5;border-color:#3e735a}
html[data-nl-mode=dark] .nl-login-toast{background:#2b3443;border-color:#815b51;color:#f4e4de}
html[data-nl-mode=dark] .nl-login-toast[data-kind=success]{border-color:#426b5a;color:#c5f0d5}
